# v4 – ONNX inference, CPU-only (no GPU provider, smallest possible image).
# Best for servers with limited RAM (3-5 GB) and no GPU.
FROM python:3.10-slim

ARG TARGETARCH

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN useradd -m appuser

COPY requirements.onnx.txt .

# Install onnxruntime (CPU-only variant – smaller package, no GPU code paths)
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --timeout 300 onnxruntime-cpu

# Install remaining dependencies
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --timeout 300 -r requirements.onnx.txt

# Copy ONNX weights and class-name map (generated by export_onnx.py)
COPY --chown=appuser weights/*.onnx     ./weights/
COPY --chown=appuser weights/model_names.json ./weights/

# Copy application code
COPY --chown=appuser app.py inference_onnx.py ./

USER appuser
ENV PATH="/home/appuser/.local/bin:$PATH"

ENV USE_ONNX=1
ENV ORT_CPU_ONLY=1
ENV PORT=8080
EXPOSE $PORT

CMD ["sh", "-c", "exec uvicorn app:app --host 0.0.0.0 --port $PORT"]
